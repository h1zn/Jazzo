<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Party mode: the relay other players connect to, and joining theirs. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Party mode finds hosts on the Wi-Fi by itself: lets its broadcasts through. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- A short buzz when the hero is hurt. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- A party hosted on this phone goes on while the app is put away
         (HostService): a foreground service with a notice in the shade,
         holding the phone awake. (Its kind, connectedDevice, is allowed
         through CHANGE_WIFI_MULTICAST_STATE above: the other phones.) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.gamepad" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />

    <application
        android:allowBackup="true"
        android:appCategory="game"
        android:enableOnBackInvokedCallback="true"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:isGame="true"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kip"
        android:usesCleartextTraffic="true">

        <!-- Party games on a home network use plain ws:// to the host's address,
             hence usesCleartextTraffic. The game's own files never leave the app. -->

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale|touchscreen"
            android:exported="true"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustNothing">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".HostService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
